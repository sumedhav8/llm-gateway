# Copy this file to .env and fill in your own values

# Cheap model (local, free, runs through Ollama)
CHEAP_BASE_URL=http://localhost:11434/v1
CHEAP_API_KEY=ollama
CHEAP_MODEL=llama3.2

# Strong model (Claude). Replace the placeholder with your real API key.
STRONG_BASE_URL=https://api.anthropic.com/v1
STRONG_API_KEY=your-api-key-here
STRONG_MODEL=claude-sonnet-5-5

# Database (used by docker-compose.yml)
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway_dev_password
POSTGRES_DB=gateway
DATABASE_URL=postgresql://gateway:gateway_dev_password@localhost:5432/gateway